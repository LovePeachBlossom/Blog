# Normalize text files to LF (WSL2/Linux/macOS)
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicit text types
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.css text eol=lf
*.styl text eol=lf
*.pug text eol=lf
*.html text eol=lf
*.xml text eol=lf

# Binary assets (never touch)
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.webp -text
*.ico -text
*.woff -text
*.woff2 -text
*.ttf -text
*.otf -text
